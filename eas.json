{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "store-screenshots": {
      "distribution": "internal",
      "environment": "production",
      "developmentClient": false,
      "autoIncrement": false,
      "env": {
        "EXPO_UPDATE_TARGET": "native"
      },
      "ios": {
        "simulator": true
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_UPDATE_TARGET": "native"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "distribution": "store",
      "ios": {
        "credentialsSource": "local"
      },
      "env": {
        "EXPO_UPDATE_TARGET": "native"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6838059210",
        "ascApiKeyPath": ".apple-credentials/AuthKey_TBW5U3MM53.p8",
        "ascApiKeyId": "TBW5U3MM53",
        "ascApiKeyIssuerId": "b0029c1f-ff38-456e-852d-0829e138259d"
      }
    }
  }
}
