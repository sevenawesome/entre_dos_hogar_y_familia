rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function self(uid) { return signed() && request.auth.uid == uid; }
  function deleting(uid) { return exists(/databases/$(database)/documents/accountDeletion/$(uid)); }
  function active(uid) { return self(uid) && !deleting(uid); }
  function admin() { return signed() && !deleting(request.auth.uid) && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['owner','admin']; }
  function allPermissions() { return ['families.view','families.edit','messages.send','emails.send','content.manage','settings.manage','roles.manage']; }
  function owner() { return admin() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role=='owner'; }
  function can(p) { return admin() && (owner() || p in get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('permissions',allPermissions())); }
  function auditAllowed(action) { return (action=='role.update' && can('roles.manage')) || (action=='message.send' && can('messages.send')) || (action in ['email.send','email.preferences.update'] && can('emails.send')) || (action in ['family.profile.update','family.reminders.update'] && can('families.edit')) || (action in ['level.save','catalog.seed'] && can('content.manage')) || (action in ['app.settings.update','branding.settings.update','email.pause','email.settings.update'] && can('settings.manage')); }
  function text(v,n) { return v is string && v.size() > 0 && v.size() <= n; }
  function date(d,k) { let value=d.get(k,null); return value==null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
  function validChild(child) {
   let birth=child.get('birthDate',null);
   return child.keys().hasOnly(['id','name','kind','birthDate']) && child.name.matches('^.{1,40}$') && child.kind in ['hijo','hija','otro'] && (birth==null || birth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
  }
  function childAt(c,i) { return i>=c.size() || validChild(c[i]); }
  function validFamily() {
   let f=request.resource.data;
   return f.keys().hasAll(['name','partner1','partner2','children','timezone','marriageDate']) && f.keys().hasOnly(['name','partner1','partner2','children','timezone','marriageDate','partner1BirthDate','partner2BirthDate','adminAuditId'])
    && text(f.name,60) && text(f.partner1,40) && text(f.partner2,40) && text(f.timezone,100)
    && f.marriageDate is string && date(f,'marriageDate') && date(f,'partner1BirthDate') && date(f,'partner2BirthDate')
    && f.children is list && f.children.size()<=10 && ((resource!=null && f.children==resource.data.children) || (childAt(f.children, 0) && childAt(f.children, 1) && childAt(f.children, 2) && childAt(f.children, 3) && childAt(f.children, 4) && childAt(f.children, 5) && childAt(f.children, 6) && childAt(f.children, 7) && childAt(f.children, 8) && childAt(f.children, 9)));
  }
  function audited(d,action,target) {
   let a=getAfter(/databases/$(database)/documents/adminAudit/$(d.auditId)).data;
   return a.actorUid==request.auth.uid && a.action==action && a.target==target && a.at==request.time;
  }
  function emptyProgress() { return {'completions':[], 'answers':{}, 'finishedAt':null}; }
  function answerAt(a,q,i) { return i>=q.size() || a[q[i].id].matches('^[\\s\\S]{1,1000}[\\s\\S]{0,1000}$'); }
  function progressShape(p,id) {
   return p.keys().hasOnly(['levelId','completions','answers','finishedAt','nextAvailableAt','lastCompletionAt','updatedAt'])
    && p.levelId==id && p.completions is list && p.answers is map && p.updatedAt==request.time
    && (p.nextAvailableAt==null || (p.nextAvailableAt is string && p.nextAvailableAt.size()<=50));
  }
  function validProgress(uid,id) {
   let f=get(/databases/$(database)/documents/families/$(uid)).data;
   let l=get(/databases/$(database)/documents/levels/$(id)).data;
   let p=request.resource.data;
   let old=resource==null ? emptyProgress() : resource.data;
   let t=get(/databases/$(database)/documents/tracking/$(uid)).data;
   let after=getAfter(/databases/$(database)/documents/tracking/$(uid)).data;
   let n=old.completions.size();
   return f.marriageDate is string && date(f,'marriageDate') && l.published && progressShape(p,id) &&
    (l.prerequisiteId==null || get(/databases/$(database)/documents/families/$(uid)/progress/$(l.prerequisiteId)).data.finishedAt!=null) &&
    ((n<l.challenges.size() && p.completions.size()==n+1
      && p.completions==old.completions.concat([p.completions[n]])
      && p.completions[n].keys().hasOnly(['challengeId','completedAt','note'])
      && p.completions[n].challengeId==l.challenges[n].id
      && p.completions[n].completedAt is string && p.completions[n].completedAt.size()<=50
      && p.completions[n].note is string && p.completions[n].note.size()<=2000
      && p.answers==old.answers && p.finishedAt==null && old.finishedAt==null
      && p.lastCompletionAt==request.time && after.lastCompletedAt==request.time
      && after.totalCompleted==t.totalCompleted+1 && after.levelId==id
      && firstJourneyReady(uid,t))
     || (resource!=null && old.finishedAt==null && text(p.finishedAt,50)
      && n==l.challenges.size() && p.completions==old.completions && p.lastCompletionAt==old.lastCompletionAt
      && p.nextAvailableAt==old.nextAvailableAt
      && p.answers.keys().size()==l.questions.size() && answerAt(p.answers, l.questions, 0) && answerAt(p.answers, l.questions, 1) && answerAt(p.answers, l.questions, 2) && answerAt(p.answers, l.questions, 3) && answerAt(p.answers, l.questions, 4) && answerAt(p.answers, l.questions, 5) && answerAt(p.answers, l.questions, 6) && answerAt(p.answers, l.questions, 7) && answerAt(p.answers, l.questions, 8) && answerAt(p.answers, l.questions, 9) && answerAt(p.answers, l.questions, 10) && answerAt(p.answers, l.questions, 11) && answerAt(p.answers, l.questions, 12) && answerAt(p.answers, l.questions, 13) && answerAt(p.answers, l.questions, 14) && answerAt(p.answers, l.questions, 15) && answerAt(p.answers, l.questions, 16) && answerAt(p.answers, l.questions, 17) && answerAt(p.answers, l.questions, 18) && answerAt(p.answers, l.questions, 19) && answerAt(p.answers, l.questions, 20) && answerAt(p.answers, l.questions, 21) && answerAt(p.answers, l.questions, 22) && answerAt(p.answers, l.questions, 23) && answerAt(p.answers, l.questions, 24) && answerAt(p.answers, l.questions, 25) && answerAt(p.answers, l.questions, 26) && answerAt(p.answers, l.questions, 27) && answerAt(p.answers, l.questions, 28) && answerAt(p.answers, l.questions, 29)
      && after.finishedCount==t.finishedCount+1));
  }
  function trackingShape(d,uid) {
   return d.keys().hasOnly(['uid','familyName','email','joinedAt','lastActivityAt','lastCompletedAt','levelId','levelOrder','completedCount','totalCompleted','finishedCount','emailVerified'])
    && d.uid==uid && text(d.familyName,60) && d.familyName==getAfter(/databases/$(database)/documents/families/$(uid)).data.name
    && d.email==request.auth.token.email && (d.get('emailVerified',false)==false || (d.get('emailVerified',false)==true && request.auth.token.get('email_verified',false)==true)) && d.lastActivityAt==request.time;
  }
  function trackingUpdate(uid) {
   let d=request.resource.data;
   let old=resource.data;
   let p=getAfter(/databases/$(database)/documents/families/$(uid)/progress/$(d.levelId)).data;
   let oldExists=exists(/databases/$(database)/documents/families/$(uid)/progress/$(d.levelId));
   let before=oldExists ? get(/databases/$(database)/documents/families/$(uid)/progress/$(d.levelId)).data : emptyProgress();
   let l=get(/databases/$(database)/documents/levels/$(d.levelId)).data;
   return d.joinedAt==old.joinedAt &&
    ((d.lastCompletedAt==request.time && d.totalCompleted==old.totalCompleted+1
      && d.finishedCount==old.finishedCount && d.completedCount==p.completions.size()
      && p.completions.size()==before.completions.size()+1 && p.updatedAt==request.time
      && d.levelOrder==l.order)
     || (d.finishedCount==old.finishedCount+1 && d.totalCompleted==old.totalCompleted && d.lastCompletedAt==old.lastCompletedAt
      && d.levelId==old.levelId && d.levelOrder==old.levelOrder && d.completedCount==old.completedCount
      && before.finishedAt==null && p.finishedAt!=null && p.updatedAt==request.time));
  }
  function avatar(v) { return v==null || (v is string && v.size()<=44000 && v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')); }
  function firstJourneyReady(uid,t) {
   return (exists(/databases/$(database)/documents/journeys/$(uid)) || t.totalCompleted>0)
    && (t.lastCompletedAt==null || request.time>=t.lastCompletedAt+duration.value(24,'h'));
  }
  function personalPhoto(p) { return p.keys().hasOnly(['dataUri','shareBirthday']) && p.shareBirthday is bool && (p.dataUri==null || (p.dataUri.size()<=16000 && p.dataUri.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))); }
  function photoAt(p,old,k,i) { return i>=k.size() || p[k[i]]==old.get(k[i],null) || (k[i].matches('^[a-zA-Z0-9_-]{1,100}$') && personalPhoto(p[k[i]])); }
  function publicMember(f,i) {
   return i==0 ? {'id':'partner-1','name':f.partner1,'birthDate':f.get('partner1BirthDate',null)} : i==1 ? {'id':'partner-2','name':f.partner2,'birthDate':f.get('partner2BirthDate',null)} : f.children[i-2];
  }
  function sharedPerson(p,f,photos) {
   let m=publicMember(f,p.index);
   let key=p.index<2 ? 'partner-'+string(p.index+1) : m.get('id','child-'+string(p.index-2));
   let pref=photos[key];
   return p.keys().hasOnly(['key','index','name','monthDay','avatar']) && p.index is int && p.key==key && p.name==m.name
    && p.monthDay==m.birthDate.replace('^[0-9]{4}-','') && pref.shareBirthday && p.avatar==pref.dataUri;
  }
  function compatible(p,photos) { return photos[p.key].shareBirthday && p.avatar==photos[p.key].dataUri; }
  function sharedAt(p,old,i,f,photos) { return i>=p.size() || ((p[i] in old && compatible(p[i],photos)) || sharedPerson(p[i],f,photos)); }
  function validPortraitDoc(uid) {
   let p=request.resource.data.people;
   let old=resource==null ? {} : resource.data.people;
   let k=p.keys();
   let shared=request.resource.data.get('publicPeople',[]);
   let before=resource==null ? [] : resource.data.get('publicPeople',[]);
   let f=getAfter(/databases/$(database)/documents/families/$(uid)).data;
   let edit=request.resource.data.get('editKey',null);
   return request.resource.data.keys().hasOnly(['people','publicPeople','updatedAt','editKey']) && request.resource.data.updatedAt==request.time
    && p is map && p.keys().size()<=12 && (p==old || (request.resource.data.keys().hasAny(['editKey']) ? (p.diff(old).changedKeys().union(p.diff(old).addedKeys()).hasOnly([edit]) && (edit==null || (edit.matches('^[a-zA-Z0-9_-]{1,100}$') && personalPhoto(p[edit])))) : (photoAt(p,old,k,0) && photoAt(p,old,k,1) && photoAt(p,old,k,2) && photoAt(p,old,k,3) && photoAt(p,old,k,4) && photoAt(p,old,k,5) && photoAt(p,old,k,6) && photoAt(p,old,k,7) && photoAt(p,old,k,8) && photoAt(p,old,k,9) && photoAt(p,old,k,10) && photoAt(p,old,k,11))))
    && shared is list && shared.size()<=12 && ((p==old && shared==before) || (sharedAt(shared,before,0,f,p) && sharedAt(shared,before,1,f,p) && sharedAt(shared,before,2,f,p) && sharedAt(shared,before,3,f,p) && sharedAt(shared,before,4,f,p) && sharedAt(shared,before,5,f,p) && sharedAt(shared,before,6,f,p) && sharedAt(shared,before,7,f,p) && sharedAt(shared,before,8,f,p) && sharedAt(shared,before,9,f,p) && sharedAt(shared,before,10,f,p) && sharedAt(shared,before,11,f,p))) && shareSafe(uid,shared);
  }
  function shareSafe(uid,shared) {
   let c=exists(/databases/$(database)/documents/community/$(uid)) ? getAfter(/databases/$(database)/documents/community/$(uid)).data : null;
   return c==null || !c.visible || c.get('people',[]).size()==0 || c.people==shared;
  }
  match /portraits/{uid} {
   allow read: if self(uid);
   allow create,update: if active(uid) && validPortraitDoc(uid);
   allow delete: if self(uid) && deleting(uid);
  }
  match /journeys/{uid} {
   allow read: if self(uid) || can('families.view');
   allow create: if active(uid) && request.resource.data.keys().hasOnly(['levelId','startedAt']) && request.resource.data.startedAt==request.time
    && get(/databases/$(database)/documents/families/$(uid)).data.marriageDate is string
    && get(/databases/$(database)/documents/tracking/$(uid)).data.totalCompleted==0
    && get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.published
    && get(/databases/$(database)/documents/levels/$(request.resource.data.levelId)).data.order==1;
   allow delete: if self(uid) && deleting(uid);
  }
  match /families/{uid} {
   allow read: if self(uid) || can('families.view');
   allow create,update: if (active(uid) || (resource!=null && can('families.edit') && audited({'auditId':request.resource.data.adminAuditId},'family.profile.update',uid))) && (resource==null || request.resource.data.timezone==resource.data.timezone) && validFamily();
   allow delete: if self(uid) && deleting(uid);
   match /progress/{id} { allow read: if self(uid); allow create,update: if active(uid) && validProgress(uid,id); allow delete: if self(uid) && deleting(uid); }
   match /levelNews/{id} {
    allow read: if self(uid);
    allow create: if active(uid) && exists(/databases/$(database)/documents/families/$(uid))
     && get(/databases/$(database)/documents/levels/$(id)).data.published==true
     && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt==request.time;
    allow delete: if self(uid) && deleting(uid);
   }
   match /devices/{id} { allow read,delete: if self(uid); }
   match /inbox/{id} {
    allow read: if self(uid);
    allow create: if can('messages.send') && !deleting(uid) && exists(/databases/$(database)/documents/families/$(uid))
      && request.resource.data.keys().hasOnly(['title','body','senderUid','createdAt','auditId'])
      && text(request.resource.data.title,100) && text(request.resource.data.body,1200)
      && request.resource.data.senderUid==request.auth.uid && request.resource.data.createdAt==request.time
      && audited(request.resource.data,'message.send',uid);
    allow delete: if self(uid) && deleting(uid);
   }
  }
  match /tracking/{uid} {
   allow read: if self(uid) || can('families.view');
   allow create: if active(uid) && trackingShape(request.resource.data,uid)
    && request.resource.data.joinedAt==request.time && request.resource.data.lastCompletedAt==null
    && request.resource.data.levelId=='' && request.resource.data.levelOrder==0 && request.resource.data.completedCount==0
    && request.resource.data.totalCompleted==0 && request.resource.data.finishedCount==0;
   allow update: if active(uid) && trackingShape(request.resource.data,uid)
    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyName','lastActivityAt','emailVerified']) || trackingUpdate(uid));
   allow delete: if self(uid) && deleting(uid);
  }
  function mailAllowed(uid) {
   return !exists(/databases/$(database)/documents/emailPreferences/$(uid)) || (get(/databases/$(database)/documents/emailPreferences/$(uid)).data.enabled && !get(/databases/$(database)/documents/emailPreferences/$(uid)).data.get('unsubscribed',false));
  }
  match /emailPreferences/{uid} {
   allow read: if self(uid) || can('families.view');
   allow create: if can('emails.send') && !deleting(uid) && exists(/databases/$(database)/documents/families/$(uid))
    && request.resource.data.keys().hasOnly(['enabled','version','updatedAt','updatedBy','auditId'])
    && request.resource.data.enabled is bool && request.resource.data.version==1
    && request.resource.data.updatedAt==request.time && request.resource.data.updatedBy==request.auth.uid
    && audited(request.resource.data,'email.preferences.update',uid);
   allow update: if can('emails.send') && !deleting(uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled','version','updatedAt','updatedBy','auditId'])
    && request.resource.data.enabled is bool && (!request.resource.data.enabled || !resource.data.get('unsubscribed',false))
    && request.resource.data.version==resource.data.version+1 && request.resource.data.updatedAt==request.time && request.resource.data.updatedBy==request.auth.uid
    && audited(request.resource.data,'email.preferences.update',uid);
   allow delete: if self(uid) && deleting(uid);
  }
  match /mailEvents/{id} {
   allow read: if self(resource.data.uid) || can('families.view');
   allow create: if active(request.resource.data.uid)
    && request.resource.data.keys().hasOnly(['uid','kind','levelId','state','createdAt','nextAttemptAt'])
    && request.resource.data.state=='pending' && request.resource.data.createdAt==request.time && request.resource.data.nextAttemptAt==request.time
    && ((request.resource.data.kind=='welcome' && request.resource.data.levelId==null && id=='welcome-'+request.auth.uid
      && !exists(/databases/$(database)/documents/tracking/$(request.auth.uid))
      && getAfter(/databases/$(database)/documents/tracking/$(request.auth.uid)).data.joinedAt==request.time)
     || (request.resource.data.kind=='levelCompleted' && request.resource.data.levelId is string && id=='level-'+request.auth.uid+'-'+request.resource.data.levelId
      && get(/databases/$(database)/documents/families/$(request.auth.uid)/progress/$(request.resource.data.levelId)).data.finishedAt==null
      && getAfter(/databases/$(database)/documents/families/$(request.auth.uid)/progress/$(request.resource.data.levelId)).data.finishedAt!=null
      && getAfter(/databases/$(database)/documents/families/$(request.auth.uid)/progress/$(request.resource.data.levelId)).data.updatedAt==request.time));
   allow delete: if self(resource.data.uid) && deleting(resource.data.uid);
  }
  function validEmailConfig(d) {
   return d.version is int && d.paused is bool && d.welcomeEnabled is bool && d.completionEnabled is bool && d.adminMessagesEnabled is bool
    && text(d.fromName,80) && d.fromEmail is string && d.fromEmail.size()<=150 && text(d.replyTo,150)
    && d.dailyLimit is int && d.dailyLimit>=1 && d.dailyLimit<=90 && d.monthlyLimit is int && d.monthlyLimit>=1 && d.monthlyLimit<=2700
    && d.subjectPrefix is string && d.subjectPrefix.size()<=40
    && text(d.welcomeTemplate,800) && text(d.completionTemplate,800);
  }
  match /config/email {
   allow read: if signed();
   allow create: if can('settings.manage') && request.resource.data.keys().hasOnly(['version','paused','fromName','fromEmail','replyTo','welcomeEnabled','completionEnabled','adminMessagesEnabled','dailyLimit','monthlyLimit','subjectPrefix','welcomeTemplate','completionTemplate','auditId']) && request.resource.data.version==1 && validEmailConfig(request.resource.data) && audited(request.resource.data,'email.settings.update','config/email');
   allow update: if can('settings.manage') && request.resource.data.version==resource.data.get('version',0)+1
    && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paused','version','auditId']) && request.resource.data.paused is bool && audited(request.resource.data,'email.pause','config/email'))
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['version','paused','fromName','fromEmail','replyTo','welcomeEnabled','completionEnabled','adminMessagesEnabled','dailyLimit','monthlyLimit','subjectPrefix','welcomeTemplate','completionTemplate','auditId']) && validEmailConfig(request.resource.data) && audited(request.resource.data,'email.settings.update','config/email')));
  }
  match /emailQueue/{id} {
   allow read: if self(resource.data.uid) || can('families.view');
   allow create: if can('emails.send') && !deleting(request.resource.data.uid) && exists(/databases/$(database)/documents/families/$(request.resource.data.uid))
    && request.resource.data.keys().hasOnly(['uid','title','body','senderUid','createdAt','auditId','state']) && request.resource.data.state=='pending'
    && request.resource.data.senderUid==request.auth.uid && request.resource.data.createdAt==request.time
    && text(request.resource.data.title,100) && text(request.resource.data.body,1200)
    && get(/databases/$(database)/documents/config/email).data.enabled && !get(/databases/$(database)/documents/config/email).data.paused && get(/databases/$(database)/documents/config/email).data.get('adminMessagesEnabled',true)
    && mailAllowed(request.resource.data.uid) && audited(request.resource.data,'email.send',request.resource.data.uid);
   allow delete: if self(resource.data.uid) && deleting(resource.data.uid);
  }
  match /mailJobs/{id} { allow read: if self(resource.data.uid) || can('families.view'); allow delete: if self(resource.data.uid) && deleting(resource.data.uid); }
  match /mailRuntime/{id} { allow read: if can('emails.send') || can('settings.manage'); }
  match /roles/{uid} {
   allow read: if self(uid) || can('roles.manage');
   allow create,update: if can('roles.manage') && uid!=request.auth.uid && !deleting(uid) && exists(/databases/$(database)/documents/tracking/$(uid))
    && (!exists(/databases/$(database)/documents/roles/$(uid)) || resource.data.role!='owner')
    && request.resource.data.keys().hasOnly(['role','permissions','updatedAt','updatedBy','auditId']) && request.resource.data.role in ['admin','member']
    && request.resource.data.keys().hasAll(['permissions']) && request.resource.data.get('permissions',[]) is list && request.resource.data.get('permissions',[]).size()<=7 && request.resource.data.get('permissions',[]).hasOnly(allPermissions())
    && (request.resource.data.role=='admin' || request.resource.data.get('permissions',[]).size()==0)
    && (!request.resource.data.get('permissions',[]).hasAny(['families.edit','messages.send','emails.send','roles.manage']) || 'families.view' in request.resource.data.permissions)
    && (owner() || (request.resource.data.get('permissions',[]).hasOnly(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('permissions',allPermissions())) && (resource==null || resource.data.role=='member' || resource.data.get('permissions',allPermissions()).hasOnly(get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('permissions',allPermissions())))))
    && request.resource.data.updatedAt==request.time && request.resource.data.updatedBy==request.auth.uid && audited(request.resource.data,'role.update',uid);
   allow delete: if self(uid) && deleting(uid) && resource.data.role!='owner';
  }
  match /avatars/{uid} {
   allow read: if self(uid);
   allow create,update: if active(uid) && request.resource.data.keys().hasOnly(['dataUri','updatedAt']) && avatar(request.resource.data.dataUri) && request.resource.data.updatedAt==request.time;
   allow delete: if self(uid);
  }
  match /community/{uid} {
   allow read: if self(uid) || (signed() && resource.data.visible==true);
   allow create,update: if active(uid)
    && request.resource.data.keys().hasOnly(['uid','alias','visible','shareAnniversary','shareProgress','marriageDate','timezone','completedCount','finishedCount','avatar','updatedAt','people'])
    && request.resource.data.uid==uid && text(request.resource.data.alias,60)
    && request.resource.data.get('people',[]) is list && request.resource.data.get('people',[]).size()<=12
    && (request.resource.data.visible || request.resource.data.get('people',[]).size()==0)
    && (request.resource.data.get('people',[]).size()==0 || request.resource.data.people==getAfter(/databases/$(database)/documents/portraits/$(uid)).data.publicPeople)
    && request.resource.data.visible is bool && request.resource.data.shareAnniversary is bool && request.resource.data.shareProgress is bool
    && request.resource.data.timezone==getAfter(/databases/$(database)/documents/families/$(uid)).data.timezone
    && request.resource.data.updatedAt==request.time && avatar(request.resource.data.avatar)
    && (!request.resource.data.shareAnniversary || request.resource.data.visible)
    && (!request.resource.data.shareProgress || request.resource.data.visible)
    && request.resource.data.marriageDate==(request.resource.data.shareAnniversary ? getAfter(/databases/$(database)/documents/families/$(uid)).data.get('marriageDate',null) : null)
    && request.resource.data.completedCount==(request.resource.data.shareProgress ? get(/databases/$(database)/documents/tracking/$(uid)).data.totalCompleted : 0)
    && request.resource.data.finishedCount==(request.resource.data.shareProgress ? get(/databases/$(database)/documents/tracking/$(uid)).data.finishedCount : 0)
    && (request.resource.data.avatar==null || (request.resource.data.visible && request.resource.data.avatar==getAfter(/databases/$(database)/documents/avatars/$(uid)).data.dataUri));
   allow delete: if self(uid);
  }
  match /config/branding {
   // This document contains public logo text only; no account or app-control fields.
   allow read: if true;
   allow create,update: if can('settings.manage') && audited(request.resource.data,'branding.settings.update','config/branding')
    && request.resource.data.keys().hasOnly(['byline','version','auditId'])
    && request.resource.data.byline is string && request.resource.data.byline.size()<=120 && !request.resource.data.byline.matches('[\\s\\S]*[\\r\\n][\\s\\S]*')
    && request.resource.data.version==(resource==null ? 1 : resource.data.version+1);
  }
  match /config/app {
   allow read: if signed();
   allow create,update: if can('settings.manage') && audited(request.resource.data,'app.settings.update','config/app')
    && request.resource.data.keys().hasOnly(['version','announcement','endTitle','endMessage','newLevelTitle','supportEmail','supportUrl','notificationsEnabled','auditId'])
    && request.resource.data.version==(resource==null ? 1 : resource.data.version+1)
    && request.resource.data.announcement is string && request.resource.data.announcement.size()<=800
    && text(request.resource.data.endTitle,100) && text(request.resource.data.endMessage,1200) && text(request.resource.data.newLevelTitle,100)
    && request.resource.data.supportEmail is string && request.resource.data.supportEmail.size()<=150
    && request.resource.data.supportUrl is string && request.resource.data.supportUrl.size()<=1000
    && request.resource.data.notificationsEnabled is bool;
  }
  match /levels/{id} {
   allow read: if can('content.manage') || (signed() && resource.data.published==true);
   allow create,update: if can('content.manage') && audited(request.resource.data,'level.save',id)
    && request.resource.data.id==id && request.resource.data.order is int && request.resource.data.order>0
    && getAfter(/databases/$(database)/documents/levelOrders/$(string(request.resource.data.order))).data.levelId==id
    && text(request.resource.data.title,100) && text(request.resource.data.subtitle,300) && text(request.resource.data.description,2000)
    && request.resource.data.challenges is list && request.resource.data.challenges.size()>0 && request.resource.data.challenges.size()<=200
    && request.resource.data.questions is list && request.resource.data.questions.size()>0 && request.resource.data.questions.size()<=30
    && request.resource.data.questionIds is list && request.resource.data.questionIds.size()==request.resource.data.questions.size()
    && request.resource.data.published is bool
    && ((request.resource.data.order==1 && request.resource.data.prerequisiteId==null) || (request.resource.data.order>1 && get(/databases/$(database)/documents/levels/$(request.resource.data.prerequisiteId)).data.published==true && get(/databases/$(database)/documents/levels/$(request.resource.data.prerequisiteId)).data.order<request.resource.data.order))
    && (resource==null || !resource.data.published || (request.resource.data.published && request.resource.data.challenges==resource.data.challenges && request.resource.data.questions==resource.data.questions && request.resource.data.order==resource.data.order && request.resource.data.prerequisiteId==resource.data.prerequisiteId));
  }
  match /levelOrders/{order} { allow read: if can('content.manage'); allow create: if can('content.manage') && request.resource.data.keys().hasOnly(['levelId']); allow update: if can('content.manage') && request.resource.data==resource.data; }
  match /familyControls/{uid} {
   allow read: if self(uid) || can('families.view');
   allow create,update: if can('families.edit') && request.resource.data.keys().hasOnly(['remindersPaused','auditId']) && request.resource.data.remindersPaused is bool && audited(request.resource.data,'family.reminders.update',uid);
   allow delete: if self(uid) && deleting(uid);
  }
  match /adminAudit/{id} { allow read: if owner(); allow create: if admin() && auditAllowed(request.resource.data.action) && request.resource.data.keys().hasOnly(['actorUid','action','target','at']) && request.resource.data.actorUid==request.auth.uid && request.resource.data.at==request.time && text(request.resource.data.action,100) && text(request.resource.data.target,200); }
  match /catalogs/anniversaries { allow read: if signed(); allow create: if can('content.manage') && audited(request.resource.data,'catalog.seed','catalogs/anniversaries') && request.resource.data.milestones is list && request.resource.data.milestones.size()<=100; }
  match /accountDeletion/{uid} {
   allow read: if self(uid);
   allow create: if self(uid) && request.auth.token.auth_time*1000>request.time.toMillis()-300000
    && (!exists(/databases/$(database)/documents/roles/$(uid)) || get(/databases/$(database)/documents/roles/$(uid)).data.role!='owner')
    && request.resource.data.keys().hasOnly(['requestedAt']) && request.resource.data.requestedAt==request.time;
  }
  match /{all=**} { allow read,write: if false; }
 }
}
