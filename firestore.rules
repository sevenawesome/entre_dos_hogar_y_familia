rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && !exists(/databases/$(database)/documents/deletedAccounts/$(uid)); }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optionalDate(data, key) { return !(key in data) || data[key] == null || (data[key] is string && data[key].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function childAt(children, i) { return i >= children.size() || (children[i] is map && children[i].keys().hasOnly(['id', 'name', 'kind', 'birthDate']) && text(children[i].name, 40) && children[i].kind in ['hijo', 'hija', 'otro'] && optionalDate(children[i], 'birthDate') && (!('id' in children[i]) || (text(children[i].id, 100) && children[i].id.matches('^[a-zA-Z0-9_-]+$')))); }
    function validFamily() {
      let f = request.resource.data;
      return f.keys().hasAll(['name', 'partner1', 'partner2', 'children', 'timezone']) && f.keys().hasOnly(['name', 'partner1', 'partner2', 'children', 'timezone', 'marriageDate', 'partner1BirthDate', 'partner2BirthDate'])
        && text(f.name, 60) && text(f.partner1, 40) && text(f.partner2, 40) && text(f.timezone, 100)
        && optionalDate(f, 'marriageDate') && optionalDate(f, 'partner1BirthDate') && optionalDate(f, 'partner2BirthDate')
        && f.children is list && f.children.size() <= 15
        && childAt(f.children, 0) && childAt(f.children, 1) && childAt(f.children, 2) && childAt(f.children, 3) && childAt(f.children, 4)
        && childAt(f.children, 5) && childAt(f.children, 6) && childAt(f.children, 7) && childAt(f.children, 8) && childAt(f.children, 9)
        && childAt(f.children, 10) && childAt(f.children, 11) && childAt(f.children, 12) && childAt(f.children, 13) && childAt(f.children, 14);
    }
    match /families/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validFamily();
      allow update: if owner(uid) && validFamily() && request.resource.data.timezone == resource.data.timezone;
      match /progress/{levelId} { allow read: if owner(uid); }
      match /devices/{deviceId} { allow read: if owner(uid); }
    }
    match /levels/{levelId} { allow read: if request.auth != null && resource.data.published == true; }
    match /catalogs/anniversaries { allow read: if request.auth != null; }
    // Content, device registrations, completions and deletion are server controlled.
    match /{document=**} { allow read, write: if false; }
  }
}
